node_modules/
.remotion/
# Renders are regenerated by `npm run render`. The six current files are kept
# in the repo so frames can be reviewed without a render; everything else in
# out/ stays out.
out/*
!out/cashew-vertical.mp4
!out/cashew-landscape.mp4
!out/locus-vertical.mp4
!out/locus-landscape.mp4
!out/cashew-poster.png
!out/locus-poster.png
