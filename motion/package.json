    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@svgr/webpack": "8.1.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/webpack-env": "1.18.8",
    "typescript": "5.9.3"
  },
  "type": "module"
