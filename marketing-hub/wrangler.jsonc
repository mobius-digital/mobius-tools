/**
 * Marketing Calendar — one deployment, every brand.
 *
 * The worker keeps the name `launch-calendar` on purpose: that name owns the
 * original workers.dev address, which is the one registered with Google
 * sign-in, bookmarked by the team, and installed on their phones. Renaming
 * the worker would abandon all three. The product calls itself Marketing
 * Calendar everywhere a person can see.
 *
 * Deploy:  npm run deploy      (from this folder)
 * Logs:    npx wrangler tail launch-calendar
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "launch-calendar",
  // Not .open-next/worker.js directly: worker-entry.js wraps it to add the
  // cron handler, which the generated file cannot carry across a rebuild.
  "main": "worker-entry.js",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "observability": {
    "enabled": true
  },

  // One tick serves every brand: Slack batch windows and daily reminders.
  "triggers": {
    "crons": ["*/5 * * * *"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "marketing-hub",
      "database_id": "e8bd83a8-100e-44ed-a639-2c3415f90e41"
    }
  ]
}
