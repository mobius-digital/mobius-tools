# Copy to .env.local and fill in. Never commit .env.local.

# Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Used for writes so the changelog cannot be bypassed from a browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The single shared password for the whole app (PRD §6).
# Changing this invalidates every existing session cookie.
APP_PASSWORD=choose-a-shared-password
