/**
 * Marketing Calendar — Cloudflare Worker config.
 *
 * Deploy:  npm run deploy      (from this folder)
 * Logs:    npx wrangler tail
 *
 * The D1 id below is filled in once, by running:
 *   npx wrangler d1 create launch-calendar
 * then pasting the id it prints.
 *
 * The shared team password is a secret, never committed:
 *   npx wrangler secret put APP_PASSWORD
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "launch-calendar",
  // Not .open-next/worker.js directly: worker-entry.js wraps it to add the
  // cron handler, which the generated file cannot carry across a rebuild.
  "main": "worker-entry.js",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "observability": {
    "enabled": true
  },

  // Slack notifications: flushes the 15-minute batch window and runs the daily
  // reminder sweep. Nothing happens on a board that has not configured Slack.
  "triggers": {
    "crons": ["*/5 * * * *"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "launch-calendar",
      "database_id": "633ebfdd-85b5-420c-9d6b-352b47de42b2"
    }
  ]
}
