{
  "id": "/profit/",
  "name": "Locus by Mobius Digital",
  "short_name": "Locus",
  "description": "Every client's ads, store, email and profit in one place, with the Strategist to ask.",
  "start_url": "/profit/?source=app",
  "scope": "/profit/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#111113",
  "theme_color": "#111113",
  "icons": [
    {
      "src": "/logo/locus/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/logo/locus/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/logo/locus/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Home",
      "url": "/profit/?open=overview",
      "icons": [
        {
          "src": "/logo/locus/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Day check",
      "url": "/profit/?open=yesterday",
      "icons": [
        {
          "src": "/logo/locus/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Today's calls",
      "url": "/profit/?open=today",
      "icons": [
        {
          "src": "/logo/locus/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Calendar",
      "url": "/profit/?open=calendar",
      "icons": [
        {
          "src": "/logo/locus/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "share_target": {
    "action": "/profit/",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}
